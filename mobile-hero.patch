+    padding: clamp(48px, 17vw, 100px) 4.5vw 28vw;
+    text-align: left;
+  }
+
+  .home-main .hero-mobile-copy h1 {
+    margin: 0;
+    color: #fff;
+    font-size: clamp(26px, 8.3vw, 50px);
+    font-weight: 400;
+    line-height: 1.23;
+    letter-spacing: -0.025em;
+  }
+
+  .home-main .hero-mobile-copy strong {
+    font-weight: 700;
+    white-space: nowrap;
+  }
+
+  .home-main .hero-mobile-copy p {
+    max-width: 76vw;
+    margin: 6vw 0 0 1.8vw;
+    color: rgba(255, 255, 255, 0.8);
+    font-size: clamp(14px, 3.85vw, 23px);
+    line-height: 1.2;
+    font-weight: 400;
+  }
+
+  .home-main .hero-mobile-ctas {
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 2.7vw;
+    margin: 9vw 0 0 1.5vw;
+  }
+
+  .home-main .hero-mobile-cta {
+    display: inline-flex;
+    align-items: center;
+    gap: 3.5vw;
+    width: max(175px, 43.5vw);
+    min-height: 44px;
+    padding: 2.4vw 3vw;
+    border-radius: 6px;
+    background: #006eff;
+    color: #fff;
+    font-size: clamp(13px, 3.5vw, 21px);
+    line-height: 1.2;
+    font-weight: 700;
+    text-decoration: none;
+  }
+
+  .home-main .hero-mobile-cta svg {
+    flex-shrink: 0;
+    width: 4.3vw;
+    height: 4.3vw;
+  }
+
+  .home-main .hero-mobile-cta-demo {
+    background: #fff;
+    color: #0065db;
+  }
+
+  .home-main .hero-mobile-cta:focus-visible {
+    outline: 3px solid #fff;
+    outline-offset: 4px;
+    box-shadow: 0 0 0 6px #1360ee;
+  }
+
+  .home-main .hero-mobile-fleet {
+    display: block;
+    position: relative;
+    z-index: 9;
+    height: 74vw;
+    background: #fff;
+    pointer-events: none;
+  }
+
+  .home-main .hero-mobile-road-surface {
+    position: absolute;
+    inset: 0;
+    overflow: hidden;
+  }
+
+  .home-main .hero-mobile-road {
+    /* Enlarge the existing curve into the tall foreground in the reference. */
+    width: 140vw !important;
+    max-width: none;
+    height: 210vw !important;
+    left: -30vw !important;
+    top: -10vw !important;
+    object-fit: fill;
+  }
+
+  .home-main .hero-mobile-vehicle {
+    position: absolute;
+  }
+
+  .home-main .hero-mobile-vehicle-image {
+    display: block;
+    width: 100%;
+    height: auto;
+  }
+
+  .home-main .hero-mobile-pin {
+    position: absolute;
+    left: 50%;
+    bottom: 85%;
+    width: 25%;
+    height: auto;
+    transform: translateX(-50%);
+  }
+
+  .home-main .hero-mobile-bus { width: 16vw; left: 21%; top: 4%; }
+  .home-main .hero-mobile-truck { width: 16vw; left: 85%; top: 1%; }
+  .home-main .hero-mobile-van { width: 22vw; left: 36%; top: 19%; }
+  .home-main .hero-mobile-car { width: 40vw; left: 0; top: 32%; }
+  .home-main .hero-mobile-scooter { width: 58vw; left: 43%; top: 40%; }
+  .home-main .hero-mobile-car .hero-mobile-pin { width: 45%; }
+  .home-main .hero-mobile-scooter .hero-mobile-pin { width: 30%; }
+  .home-main .hero-mobile-bus .hero-mobile-pin,
+  .home-main .hero-mobile-van .hero-mobile-pin { width: 12%; }
+}
